<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>Desk Buddy AI</title>
<style>
  :root {
    --eye: #9be7e0;
    --glow: #3fb8b0;
    --bg: #000000;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  html, body {
    height: 100%;
    width: 100%;
    background: var(--bg);
    overflow: hidden;
    font-family: system-ui, -apple-system, sans-serif;
    color: #fff;
    transition: background-color 0.3s ease;
  }
  #viewport-wrapper {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity .8s ease;
  }
  #look {
    display: flex;
    gap: 6vmin;
    transition: transform .45s cubic-bezier(.3, .8, .3, 1);
  }
  .side {
    position: relative;
  }
  .side.l { --s: -1; }
  .side.r { --s: 1; }
  
  .brow {
    --by: 0vmin;
    --br: 0deg;
    --bh: 5vmin;
    --lift: 0vmin;
    position: absolute;
    left: 50%;
    bottom: calc(100% + 3vmin);
    width: 21vmin;
    height: var(--bh);
    margin-left: -10.5vmin;
    border-top: 2.6vmin solid var(--eye);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    filter: drop-shadow(0 0 1.6vmin var(--glow));
    transform: translateY(calc(var(--by) + var(--lift))) rotate(calc(var(--br) * var(--s) * -1));
    transition: transform .28s cubic-bezier(.3, 1.4, .5, 1), height .3s, border-color .3s, filter .3s;
  }
  #stage.emph .brow {
    --lift: -1.4vmin;
  }
  .eye {
    --upper: -110%;
    --lower: 110%;
    --rot: 0deg;
    --sy: 1;
    --sx: 1;
    width: 22vmin;
    height: 30vmin;
    border-radius: 48%;
    background: var(--eye);
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 5vmin var(--glow);
    transform: scale(var(--sx), var(--sy));
    transition: transform .18s ease-out, border-radius .3s, height .3s, background-color .3s, box-shadow .3s;
  }
  
  body.shape-oval .eye { border-radius: 30% 30% 50% 50%; }
  body.shape-sleek .eye { border-radius: 15%; }
  body.shape-almond .eye { border-radius: 60% 0% 60% 0%; }

  .eye::before {
    content: "";
    position: absolute;
    left: -25%;
    right: -25%;
    bottom: -70%;
    height: 90%;
    background: var(--bg);
    border-radius: 50%;
    transform: translateY(var(--lower));
    transition: transform .3s;
  }
  .eye::after {
    content: "";
    position: absolute;
    left: -40%;
    right: -40%;
    top: -5%;
    height: 70%;
    background: var(--bg);
    transform: translateY(var(--upper)) rotate(calc(var(--rot) * var(--s)));
    transition: transform .3s;
  }
  #stage.talk #look {
    animation: bob .42s ease-in-out infinite alternate;
  }
  @keyframes bob {
    to { transform: translateY(1.4vmin); }
  }
  #stage.excited #look {
    animation: hop .32s ease-in-out infinite alternate;
  }
  @keyframes hop {
    to { transform: translateY(-1.8vmin); }
  }
  #stage.confused #look {
    transform: rotate(-6deg);
  }
  #stage.listen .eye {
    box-shadow: 0 0 8vmin 1.5vmin var(--glow);
  }
  #stage.sleep {
    opacity: .0;
  }

  #sub {
    position: absolute;
    left: 50%;
    bottom: 14vmin;
    transform: translateX(-50%);
    width: 58vmin;
    text-align: center;
    color: var(--eye);
    font-size: 3.2vmin;
    line-height: 1.25;
    opacity: 0;
    transition: opacity .4s ease;
    pointer-events: none;
    z-index: 10;
    text-shadow: 0 0 8px rgba(0,0,0,0.8);
  }
  #sub.on {
    opacity: 1;
  }

  #clock-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  #clock-overlay.on {
    opacity: 1;
    pointer-events: auto;
  }
  #clock-time {
    font-size: 16vmin;
    font-weight: 700;
    color: var(--eye);
    text-shadow: 0 0 20px var(--glow);
    font-family: monospace, system-ui;
  }
  #clock-date {
    font-size: 4vmin;
    color: #88a;
    margin-top: 1vmin;
  }

  #torch-overlay {
    position: absolute;
    inset: 0;
    background: #ffffff;
    z-index: 200;
    display: none;
    cursor: pointer;
  }
  #torch-overlay.on {
    display: block;
  }

  #image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(6px);
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    cursor: pointer;
    padding: 4vmin;
  }
  #image-overlay.on {
    opacity: 1;
    pointer-events: auto;
  }
  #image-display {
    max-width: 80vmin;
    max-height: 65vh;
    border-radius: 4vmin;
    border: 2px solid var(--eye);
    box-shadow: 0 0 25px var(--glow);
    object-fit: contain;
  }
  #image-caption {
    color: var(--eye);
    font-size: 3vmin;
    margin-top: 2vmin;
    text-align: center;
  }

  #radio-banner {
    position: absolute;
    top: 15vmin;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(17, 26, 25, 0.88);
    border: 1px solid var(--eye);
    box-shadow: 0 0 15px var(--glow);
    border-radius: 3vmin;
    padding: 1.5vmin 3vmin;
    display: flex;
    align-items: center;
    gap: 2vmin;
    z-index: 25;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  #radio-banner.on {
    opacity: 1;
    pointer-events: auto;
  }
  #radio-banner span {
    color: var(--eye);
    font-size: 2.8vmin;
  }
  #radio-stop-btn {
    background: #222;
    border: 1px solid var(--eye);
    color: var(--eye);
    border-radius: 2vmin;
    padding: 0.5vmin 1.5vmin;
    font-size: 2.2vmin;
    cursor: pointer;
  }

  #cam-preview, #cam-canvas {
    display: none;
  }

  #gear-btn {
    position: absolute;
    top: 5vmin;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(155, 231, 224, 0.2);
    color: var(--eye);
    width: 8vmin;
    height: 8vmin;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5vmin;
    cursor: pointer;
    z-index: 20;
    transition: opacity 0.3s, background-color 0.3s;
  }
  #gear-btn:active {
    background: rgba(155, 231, 224, 0.3);
  }

  #config-modal {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6vmin;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity .3s ease;
  }
  #config-modal.open {
    opacity: 1;
    pointer-events: auto;
  }
  .modal-box {
    width: 75vmin;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    gap: 2vmin;
    text-align: center;
    max-height: 85vh;
    overflow-y: auto;
  }
  .modal-box h2 {
    color: var(--eye);
    font-size: 4vmin;
    font-weight: 600;
  }
  .modal-box p {
    color: #88a;
    font-size: 2.6vmin;
    line-height: 1.3;
  }
  .modal-box input,
  .modal-box select {
    width: 100%;
    padding: 2vmin 3vmin;
    background: #111a19;
    border: 1px solid #3fb8b0;
    border-radius: 3vmin;
    color: #fff;
    font-size: 2.8vmin;
    outline: none;
    text-align: center;
  }
  .modal-box input[type="color"] {
    height: 6vmin;
    padding: 0.5vmin;
    cursor: pointer;
  }
  .modal-box select {
    appearance: none;
    cursor: pointer;
    text-align-last: center;
  }
  .modal-box input:focus,
  .modal-box select:focus {
    border-color: var(--eye);
    box-shadow: 0 0 10px rgba(155, 231, 224, 0.3);
  }
  .perm-btn {
    padding: 2vmin 3vmin;
    background: #122b28;
    border: 1px solid #3fb8b0;
    color: var(--eye);
    border-radius: 2.5vmin;
    font-size: 2.6vmin;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5vmin;
    transition: background-color 0.2s;
    text-decoration: none;
  }
  .perm-btn:active {
    background: #1e3d39;
  }
  .google-btn {
    background: #ffffff;
    color: #1f1f1f;
    border: 1px solid #dadce0;
    font-weight: 600;
  }
  .google-btn:active {
    background: #eeeeee;
  }
  #mic-status, #cam-status {
    font-size: 2.4vmin;
    min-height: 3.2vmin;
    color: #88a;
  }
  .toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1vmin 2vmin;
    background: #111a19;
    border: 1px solid #3fb8b0;
    border-radius: 2.5vmin;
  }
  .toggle-row label {
    font-size: 2.6vmin;
    color: var(--eye);
  }
  .toggle-row input[type="checkbox"] {
    width: auto;
    transform: scale(1.4);
    cursor: pointer;
  }
  .modal-actions {
    display: flex;
    gap: 2vmin;
    justify-content: center;
    margin-top: 1vmin;
  }
  .btn {
    padding: 2vmin 4vmin;
    border-radius: 3vmin;
    border: none;
    font-size: 2.8vmin;
    font-weight: bold;
    cursor: pointer;
  }
  .btn-primary {
    background: #3fb8b0;
    color: #000;
  }
  .btn-secondary {
    background: #222;
    color: #888;
  }
  #test {
    position: absolute;
    left: 50%;
    bottom: 3vmin;
    transform: translateX(-50%);
    display: none;
    gap: 1vmin;
    flex-wrap: wrap;
    justify-content: center;
    width: 65vmin;
    z-index: 15;
  }
  #test.on { display: flex; }
  #test button {
    font-size: 2.2vmin;
    padding: .6vmin 1.2vmin;
    border: 1px solid #3fb8b0;
    background: #111;
    color: var(--eye);
    border-radius: 2vmin;
  }
  @media (prefers-reduced-motion: reduce) {
    #stage.talk #look, #stage.excited #look { animation: none; }
  }
</style>
</head>
<body>
<div id="viewport-wrapper">
  <button id="gear-btn" aria-label="Settings" title="Configure AI Provider, API Keys & Permissions">⚙️</button>

  <div id="torch-overlay"></div>

  <div id="image-overlay">
    <img id="image-display" src="" alt="Fetched Visual">
    <div id="image-caption">Tap or say "close picture" to dismiss</div>
  </div>

  <div id="radio-banner">
    <span id="radio-title">📻 Playing Radio...</span>
    <button id="radio-stop-btn" onclick="stopRadio()">Stop</button>
  </div>
  <audio id="radio-player" preload="none"></audio>

  <video id="cam-preview" playsinline></video>
  <canvas id="cam-canvas"></canvas>

  <div id="clock-overlay">
    <div id="clock-time">00:00</div>
    <div id="clock-date">Monday, Jan 1</div>
  </div>

  <div id="stage">
    <div id="look">
      <div class="side l"><div class="brow"></div><div class="eye"></div></div>
      <div class="side r"><div class="brow"></div><div class="eye"></div></div>
    </div>
  </div>

  <div id="sub"></div>
  <div id="test"></div>

  <div id="config-modal">
    <div class="modal-box">
      <h2>Desk Buddy Setup</h2>
      
      <p>AI Provider:</p>
      <select id="provider-select">
        <option value="gemini">Google Gemini</option>
        <option value="grok">xAI Grok</option>
      </select>

      <div id="gemini-key-group">
        <p>Get your free Gemini Key with Google:</p>
        <a class="perm-btn google-btn" href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
          Login with Google to Get Key
        </a>
        <p style="margin-top: 1.5vmin;">Paste Gemini API Key:</p>
        <input type="password" id="api-key-input" placeholder="AIzaSy..." autocomplete="off">
      </div>

      <div id="grok-key-group">
        <p>Enter your Grok (xAI) API Key:</p>
        <input type="password" id="grok-key-input" placeholder="xai-..." autocomplete="off">
      </div>

      <p>Theme Color:</p>
      <select id="theme-select">
        <option value="cyan">Cyan (Default)</option>
        <option value="pink">Neon Pink</option>
        <option value="amber">Amber Gold</option>
        <option value="green">Matrix Green</option>
        <option value="blue">Royal Blue</option>
        <option value="custom">Custom Color</option>
      </select>
      <div id="custom-color-group" style="display:none;">
        <p style="margin-top: 1vmin;">Custom Eye Color:</p>
        <input type="color" id="custom-color-picker" value="#9be7e0">
      </div>

      <p>Eye Shape / Avatar:</p>
      <select id="shape-select">
        <option value="default">Round (Default)</option>
        <option value="oval">Cute Oval</option>
        <option value="sleek">Sleek Hexagon</option>
        <option value="almond">Soft Almond</option>
      </select>

      <p>Voice:</p>
      <select id="voice-select">
        <option value="">Auto (most natural available)</option>
      </select>
      <button class="perm-btn" id="btn-test-voice">🔊 Preview Voice</button>

      <div class="toggle-row">
        <label for="wakeword-toggle">Enable "Hey Burt" Wake Word</label>
        <input type="checkbox" id="wakeword-toggle">
      </div>

      <button class="perm-btn" id="btn-request-mic">🎙️ Request Mic Permission</button>
      <div id="mic-status">Mic Status: Unknown</div>

      <button class="perm-btn" id="btn-request-cam">📷 Enable Camera for Burt Vision</button>
      <div id="cam-status">Camera Status: Unknown</div>

      <div class="modal-actions">
        <button class="btn btn-secondary" id="cancel-config-btn">Cancel</button>
        <button class="btn btn-primary" id="save-config-btn">Save Settings</button>
      </div>
    </div>
  </div>
</div>

<script>
(function initPWA() {
  const manifestData = {
    name: "Desk Buddy AI",
    short_name: "DeskBuddy",
    start_url: "./index.html",
    display: "standalone",
    background_color: "#000000",
    theme_color: "#000000",
    orientation: "any",
    icons: [
      {
        src: "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23000'/><circle cx='35' cy='50' r='12' fill='%239be7e0'/><circle cx='65' cy='50' r='12' fill='%239be7e0'/></svg>",
        sizes: "192x192 512x512",
        type: "image/svg+xml"
      }
    ]
  };
  const stringManifest = JSON.stringify(manifestData);
  const blob = new Blob([stringManifest], { type: 'application/json' });
  const manifestURL = URL.createObjectURL(blob);
  const link = document.createElement('link');
  link.rel = 'manifest';
  link.href = manifestURL;
  document.head.appendChild(link);

  if ('serviceWorker' in navigator) {
    const swCode = `
      self.addEventListener('install', e => self.skipWaiting());
      self.addEventListener('activate', e => self.clients.claim());
      self.addEventListener('fetch', e => {
        e.respondWith(fetch(e.request).catch(() => caches.match(e.request)));
      });
    `;
    const swBlob = new Blob([swCode], { type: 'text/javascript' });
    const swUrl = URL.createObjectURL(swBlob);
    navigator.serviceWorker.register(swUrl).catch(() => {});
  }
})();

let GEMINI_API_KEY = localStorage.getItem("desk_buddy_gemini_key") || "";
const GEMINI_MODEL = "gemini-2.5-flash";
let GROK_API_KEY = localStorage.getItem("desk_buddy_grok_key") || "";
const GROK_MODEL = "grok-4";
let AI_PROVIDER = localStorage.getItem("desk_buddy_provider") || "gemini";
let WAKEWORD_ENABLED = localStorage.getItem("desk_buddy_wakeword") === "true";
let THEME_PRESET = localStorage.getItem("desk_buddy_theme") || "cyan";
let CUSTOM_COLOR = localStorage.getItem("desk_buddy_custom_color") || "#9be7e0";
let AVATAR_SHAPE = localStorage.getItem("desk_buddy_shape") || "default";
const LONG_PRESS_MS = 900;

const stage = document.getElementById("stage");
const look = document.getElementById("look");
const eyes = [...document.querySelectorAll(".eye")];
const brows = [...document.querySelectorAll(".brow")];
const voiceSelect = document.getElementById("voice-select");
const btnTestVoice = document.getElementById("btn-test-voice");
let VOICE_NAME = localStorage.getItem("desk_buddy_voice") || "";
const sub = document.getElementById("sub");
const gearBtn = document.getElementById("gear-btn");
const configModal = document.getElementById("config-modal");
const apiKeyInput = document.getElementById("api-key-input");
const btnRequestMic = document.getElementById("btn-request-mic");
const micStatus = document.getElementById("mic-status");
const btnRequestCam = document.getElementById("btn-request-cam");
const camStatus = document.getElementById("cam-status");
const saveConfigBtn = document.getElementById("save-config-btn");
const cancelConfigBtn = document.getElementById("cancel-config-btn");
const providerSelect = document.getElementById("provider-select");
const themeSelect = document.getElementById("theme-select");
const customColorGroup = document.getElementById("custom-color-group");
const customColorPicker = document.getElementById("custom-color-picker");
const shapeSelect = document.getElementById("shape-select");
const grokKeyInput = document.getElementById("grok-key-input");
const geminiKeyGroup = document.getElementById("gemini-key-group");
const grokKeyGroup = document.getElementById("grok-key-group");
const clockOverlay = document.getElementById("clock-overlay");
const clockTime = document.getElementById("clock-time");
const clockDate = document.getElementById("clock-date");
const torchOverlay = document.getElementById("torch-overlay");
const imageOverlay = document.getElementById("image-overlay");
const imageDisplay = document.getElementById("image-display");
const imageCaption = document.getElementById("image-caption");
const radioBanner = document.getElementById("radio-banner");
const radioTitle = document.getElementById("radio-title");
const radioPlayer = document.getElementById("radio-player");
const wakewordToggle = document.getElementById("wakeword-toggle");
const camVideo = document.getElementById("cam-preview");
const camCanvas = document.getElementById("cam-canvas");

const COLOR_PRESETS = {
  cyan:  { eye: "#9be7e0", glow: "#3fb8b0" },
  pink:  { eye: "#ff77a9", glow: "#ff3377" },
  amber: { eye: "#ffc857", glow: "#e69500" },
  green: { eye: "#57ff90", glow: "#00cc44" },
  blue:  { eye: "#57b3ff", glow: "#0077ff" }
};

function applyVisualTheme(theme, customHex, shape) {
  let colors = COLOR_PRESETS[theme] || COLOR_PRESETS.cyan;
  if (theme === "custom" && customHex) {
    colors = { eye: customHex, glow: customHex };
  }
  
  document.documentElement.style.setProperty("--eye", colors.eye);
  document.documentElement.style.setProperty("--glow", colors.glow);

  document.body.classList.remove("shape-oval", "shape-sleek", "shape-almond");
  if (shape && shape !== "default") {
    document.body.classList.add(`shape-${shape}`);
  }
}
applyVisualTheme(THEME_PRESET, CUSTOM_COLOR, AVATAR_SHAPE);

async function searchAndPlayRadio(query) {
  try {
    const cleanTerm = encodeURIComponent(query.replace(/play radio|play station|play stream|listen to radio|play|tune into|tune in to/gi, "").trim());
    const res = await fetch(`https://de1.api.radio-browser.info/json/stations/byname/${cleanTerm}?limit=1`);
    const stations = await res.json();
    if (stations && stations.length > 0) {
      const station = stations[0];
      const streamUrl = station.url_resolved || station.url;
      radioPlayer.src = streamUrl;
      radioPlayer.play();
      radioTitle.textContent = `📻 ${station.name}`;
      radioBanner.classList.add("on");
      speak(`Now playing ${station.name}`, "happy");
      return true;
    }
  } catch (err) {}
  return false;
}

function stopRadio() {
  radioPlayer.pause();
  radioPlayer.src = "";
  radioBanner.classList.remove("on");
  speak("Radio stopped.", "idle");
}

async function searchWebImage(query) {
  try {
    const cleanQuery = encodeURIComponent(query.replace(/show me a picture of|show me an image of|show picture of|show image of|picture of|photo of|image of/gi, "").trim());
    const res = await fetch(`https://commons.wikimedia.org/w/api.php?action=query&generator=search&gteissearch=1&gsrsearch=${cleanQuery}&gsrnamespace=6&gsrlimit=1&prop=imageinfo&iiprop=url&format=json&origin=*`);
    const data = await res.json();
    if (data.query && data.query.pages) {
      const pageId = Object.keys(data.query.pages)[0];
      return data.query.pages[pageId].imageinfo[0].url;
    }
  } catch (err) {}
  return null;
}

function showPicture(url, title) {
  imageDisplay.src = url;
  imageCaption.textContent = title ? `${title} (Tap or say "close picture")` : `Tap or say "close picture" to dismiss`;
  imageOverlay.classList.add("on");
}

function closePicture() {
  if (imageOverlay.classList.contains("on")) {
    imageOverlay.classList.remove("on");
    speak("Picture closed.", "idle");
  }
}
imageOverlay.onclick = closePicture;

let clockTimer;
function showTimeDisplay() {
  const now = new Date();
  clockTime.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  clockDate.textContent = now.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });
  clockOverlay.classList.add("on");
  
  const timeSpoken = now.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
  speak(`The time is ${timeSpoken}`, "happy");

  clearTimeout(clockTimer);
  clockTimer = setTimeout(() => {
    clockOverlay.classList.remove("on");
  }, 8000);
}

function enableTorch() {
  torchOverlay.classList.add("on");
  speak("Torch activated. Tap anywhere to turn off.", "surprised");
}

function disableTorch() {
  if (torchOverlay.classList.contains("on")) {
    torchOverlay.classList.remove("on");
    speak("Torch off.", "idle");
  }
}
torchOverlay.onclick = disableTorch;

async function fetchNewsHeadlines() {
  setFace("thinking");
  say("Fetching top headlines...", 4000);
  try {
    const res = await fetch("https://api.rss2json.com/v1/api.json?rss_url=https://feeds.bbci.co.uk/news/rss.xml");
    if (!res.ok) throw new Error("News feed unavailable");
    const data = await res.json();
    const headlines = data.items.slice(0, 3).map(item => item.title).join(". ");
    speak(`Here are the top headlines: ${headlines}`, "happy");
  } catch (err) {
    speak("Sorry, I couldn't fetch the news right now.", "sad");
  }
}

const FACES = {
  idle:      {},
  listening: { sx:1.08, sy:1.08, by:"-1.5vmin", bh:"6vmin" },
  thinking:  { upper:"-52%", rot:"14deg", by:"1vmin", br:"-12deg", bh:"3vmin" },
  happy:     { lower:"28%", by:"-2vmin", bh:"7vmin" },
  excited:   { lower:"34%", sx:1.06, sy:1.06, by:"-3.5vmin", bh:"8vmin" },
  sad:       { upper:"-48%", rot:"22deg", sy:.92, by:"1vmin", br:"-24deg", bh:"4vmin" },
  angry:     { upper:"-62%", rot:"-24deg", sy:.9, by:"2.5vmin", br:"26deg", bh:"1.5vmin" },
  confused:  { upper:"-70%", rot:"10deg", by:"-1vmin", br:"-18deg", bh:"5vmin" },
  surprised: { sx:.82, sy:1.22, by:"-5vmin", bh:"8vmin" },
  sleepy:    { upper:"-18%", sy:.85, by:"2vmin", bh:"2vmin" },
  sleep:     { upper:"-4%", sy:.5, by:"3vmin", bh:"1vmin" }
};
const DEFAULTS = { upper:"-110%", lower:"110%", rot:"0deg", sy:1, sx:1, by:"0vmin", br:"0deg", bh:"5vmin" };

let state = "idle", asleep = false, busy = false, speaking = false;

function setFace(name) {
  const f = Object.assign({}, DEFAULTS, FACES[name] || {});
  state = name;
  for (const e of eyes) {
    e.style.setProperty("--upper", f.upper);
    e.style.setProperty("--lower", f.lower);
    e.style.setProperty("--rot", f.rot);
    e.style.setProperty("--sx", f.sx);
    e.style.setProperty("--sy", f.sy);
  }
  for (const b of brows) {
    b.style.setProperty("--by", f.by);
    b.style.setProperty("--br", f.br);
    b.style.setProperty("--bh", f.bh);
  }
  stage.classList.toggle("listen", name === "listening");
  stage.classList.toggle("excited", name === "excited");
  stage.classList.toggle("confused", name === "confused");
  if (name === "thinking") lookAt(.7, -.6); else if (name !== "idle") lookAt(0, 0);
}

function lookAt(x, y) {
  look.style.transform = `translate(${x * 7}vmin, ${y * 5}vmin)`;
}

function blink() {
  if (asleep) return;
  const f = Object.assign({}, DEFAULTS, FACES[state] || {});
  for (const e of eyes) e.style.setProperty("--sy", .06);
  setTimeout(() => { if (!asleep) for (const e of eyes) e.style.setProperty("--sy", f.sy); }, 130);
}
(function blinkLoop() { blink(); setTimeout(blinkLoop, 2200 + Math.random() * 4200); })();

(function wander() {
  if (state === "idle" && !asleep) lookAt(Math.random() * 2 - 1, Math.random() * 1.2 - .6);
  setTimeout(wander, 1800 + Math.random() * 3000);
})();

setInterval(() => {
  if (state === "thinking") lookAt(Math.random() > .5 ? .8 : -.2, -.6);
}, 700);

let subTimer;
function say(text, ms = 4000) {
  sub.textContent = text;
  sub.classList.add("on");
  clearTimeout(subTimer);
  subTimer = setTimeout(() => sub.classList.remove("on"), ms);
}

function sleepNow() {
  if ("speechSynthesis" in window) speechSynthesis.cancel();
  asleep = true;
  stage.classList.add("sleep");
  stage.classList.remove("talk");
  setFace("sleep");
  sub.classList.remove("on");
  clockOverlay.classList.remove("on");
  imageOverlay.classList.remove("on");
}

function wake() {
  asleep = false;
  stage.classList.remove("sleep");
  setFace("surprised");
  setTimeout(() => setFace("idle"), 900);
}

const VOICE_TONE = { 
  happy:[1.15, 1.1], 
  excited:[1.25, 1.2], 
  sad:[0.95, 0.9], 
  angry:[1.15, 0.85], 
  confused:[1.05, 1.05], 
  surprised:[1.2, 1.2], 
  sleepy:[0.9, 0.9], 
  thinking:[1.05, 1] 
};
const NATURAL = /natural|neural|online|enhanced|premium|siri|google|samantha|aria|jenny|guy/i;

function pickVoice() {
  if (!("speechSynthesis" in window)) return null;
  const all = speechSynthesis.getVoices();
  if (VOICE_NAME) { const m = all.find(v => v.name === VOICE_NAME); if (m) return m; }
  const lang = (navigator.language || "en-US").slice(0, 2);
  const local = all.filter(v => v.lang.startsWith(lang));
  const pool = local.length ? local : all;
  return pool.find(v => NATURAL.test(v.name)) || pool.find(v => v.default) || pool[0] || null;
}

function fillVoices() {
  if (!("speechSynthesis" in window)) return;
  const all = speechSynthesis.getVoices();
  if (!all.length) return;
  voiceSelect.length = 1;
  for (const v of all) voiceSelect.add(new Option(`${v.name} (${v.lang})`, v.name));
  voiceSelect.value = VOICE_NAME;
}

if ("speechSynthesis" in window) { 
  fillVoices(); 
  speechSynthesis.onvoiceschanged = fillVoices;
  window.addEventListener('pointerdown', () => {
    const warmUtterance = new SpeechSynthesisUtterance("");
    warmUtterance.volume = 0;
    speechSynthesis.speak(warmUtterance);
  }, { once: true });
}

function speak(text, emotion) {
  setFace(emotion in FACES ? emotion : "happy");
  say(text, 5000 + text.length * 60);
  if (!("speechSynthesis" in window)) {
    setTimeout(() => setFace("idle"), 2500);
    return;
  }
  const u = new SpeechSynthesisUtterance(text);
  const v = pickVoice();
  if (v) { u.voice = v; u.lang = v.lang; }
  const tone = VOICE_TONE[emotion] || [1.1, 1];
  u.rate = tone[0]; u.pitch = tone[1];
  u.onboundary = () => { stage.classList.add("emph"); setTimeout(() => stage.classList.remove("emph"), 160); };
  u.onstart = () => { speaking = true; stage.classList.add("talk"); };
  u.onend = u.onerror = () => {
    speaking = false;
    stage.classList.remove("talk");
    setTimeout(() => {
      if (!busy) setFace("idle");
      if (WAKEWORD_ENABLED && !asleep && !busy) startWakeWordListener();
    }, 400);
  };
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}

async function captureCameraFrame() {
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    throw new Error("Camera API not supported in browser.");
  }
  const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
  camVideo.srcObject = stream;
  await camVideo.play();

  camCanvas.width = camVideo.videoWidth || 640;
  camCanvas.height = camVideo.videoHeight || 480;
  const ctx = camCanvas.getContext("2d");
  ctx.drawImage(camVideo, 0, 0, camCanvas.width, camCanvas.height);

  stream.getTracks().forEach(track => track.stop());

  const dataUrl = camCanvas.toDataURL("image/jpeg", 0.85);
  return dataUrl.split(",")[1];
}

const SYSTEM_PROMPT = "You are Burt, an expressive Desk Buddy companion on a round desk screen. Keep answers punchy, natural, and under 2 short sentences for quick speech synthesis. Talk like a real friend using contractions and casual phrasing. Pick an expressive emotion matching your output from: happy, excited, sad, angry, confused, surprised, sleepy, sleep, thinking, idle.";
const EMOTIONS = ["idle", "listening", "thinking", "happy", "excited", "sad", "angry", "confused", "surprised", "sleepy", "sleep"];

async function askGemini(text, base64Image = null) {
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${GEMINI_API_KEY}`;
  
  const userParts = [{ text: text || "What do you see in front of you?" }];
  if (base64Image) {
    userParts.unshift({
      inline_data: {
        mime_type: "image/jpeg",
        data: base64Image
      }
    });
  }

  const payload = {
    system_instruction: {
      parts: [{ text: SYSTEM_PROMPT }]
    },
    contents: [{ parts: userParts }],
    generationConfig: {
      responseMimeType: "application/json",
      responseSchema: {
        type: "OBJECT",
        properties: {
          emotion: { type: "STRING", enum: EMOTIONS },
          say: { type: "STRING" }
        },
        required: ["emotion", "say"]
      }
    }
  };
  const res = await fetch(url, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });
  if (!res.ok) throw new Error(`HTTP Error: ${res.status}`);
  const data = await res.json();
  return JSON.parse(data.candidates[0].content.parts[0].text);
}

async function askGrok(text) {
  const payload = {
    model: GROK_MODEL,
    messages: [
      { role: "system", content: SYSTEM_PROMPT },
      { role: "user", content: text }
    ],
    response_format: {
      type: "json_schema",
      json_schema: {
        name: "buddy_reply",
        schema: {
          type: "object",
          properties: {
            emotion: { type: "string", enum: EMOTIONS },
            say: { type: "string" }
          },
          required: ["emotion", "say"]
        }
      }
    }
  };
  const res = await fetch("https://api.x.ai/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": `Bearer ${GROK_API_KEY}`
    },
    body: JSON.stringify(payload)
  });
  if (!res.ok) throw new Error(`HTTP Error: ${res.status}`);
  const data = await res.json();
  return JSON.parse(data.choices[0].message.content);
}

const PROVIDERS = {
  gemini: { label: "Gemini", ask: askGemini, key: () => GEMINI_API_KEY },
  grok: { label: "Grok", ask: askGrok, key: () => GROK_API_KEY }
};

async function ask(text) {
  const clean = text.toLowerCase().trim();

  if (/(stop radio|turn off radio|stop music|pause radio)/i.test(clean)) {
    stopRadio();
    return;
  }
  if (/(play radio|play station|listen to radio|radio)/i.test(clean)) {
    setFace("thinking");
    say("Tuning into radio...", 3000);
    const played = await searchAndPlayRadio(clean);
    if (!played) speak("Sorry, I couldn't find a radio stream for that.", "sad");
    return;
  }

  if (/(close picture|close image|close photo|dismiss picture)/i.test(clean)) {
    closePicture();
    return;
  }
  if (/(time|what time is it|clock)/i.test(clean)) {
    showTimeDisplay();
    return;
  }
  if (/(goodnight|go to sleep|turn off display|sleep now)/i.test(clean)) {
    speak("Goodnight!", "sleepy");
    setTimeout(sleepNow, 1200);
    return;
  }
  if (/(torch|flashlight|light|turn screen white)/i.test(clean)) {
    enableTorch();
    return;
  }
  if (/(what's happening|news|headlines|read news)/i.test(clean)) {
    fetchNewsHeadlines();
    return;
  }

  const isImageRequest = /(show me a picture|show me an image|show picture|show photo|show image|picture of|photo of|image of)/i.test(clean);
  if (isImageRequest) {
    setFace("thinking");
    say("Searching picture...", 4000);
    const imgUrl = await searchWebImage(clean);
    if (imgUrl) {
      const searchTerm = clean.replace(/(show me a picture of|show me an image of|show picture of|show image of|picture of|photo of|image of)/gi, "").trim();
      showPicture(imgUrl, searchTerm);
      speak(`Here is a picture of ${searchTerm}!`, "happy");
      return;
    } else {
      speak("Sorry, I couldn't find a picture for that.", "sad");
      return;
    }
  }

  const isVisionQuery = /(see|look|what is this|who is this|view|watch)/i.test(clean);

  let provider = PROVIDERS[AI_PROVIDER] || PROVIDERS.gemini;
  if (!provider.key()) {
    setFace("sad");
    say(`Please configure your ${provider.label} API key in settings.`, 5000);
    return;
  }
  const label = provider.label;
  busy = true;
  setFace("thinking");

  try {
    let reply;
    if (isVisionQuery && AI_PROVIDER === "gemini") {
      say("Looking through camera...", 3000);
      const frameData = await captureCameraFrame();
      reply = await askGemini(text, frameData);
    } else {
      reply = await provider.ask(text);
    }

    busy = false;
    if (reply.emotion === "sleep") {
      if (reply.say) speak(reply.say, "sleepy");
      setTimeout(sleepNow, 2500);
      return;
    }
    speak(reply.say || " ", reply.emotion);
  } catch (err) {
    busy = false;
    setFace("sad");
    say(`Can't reach ${label} or fetch details. Check network or keys.`, 6000);
    setTimeout(() => setFace("idle"), 4000);
  }
}

const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let wakeRec = null;
let wakeWordActive = false;

function startWakeWordListener() {
  if (!SR || !WAKEWORD_ENABLED || wakeWordActive || busy || speaking || configModal.classList.contains("open")) return;
  
  try {
    wakeRec = new SR();
    wakeRec.lang = navigator.language || "en-US";
    wakeRec.continuous = true;
    wakeRec.interimResults = true;
    wakeWordActive = true;

    wakeRec.onresult = ev => {
      for (let i = ev.resultIndex; i < ev.results.length; ++i) {
        const transcript = ev.results[i][0].transcript.toLowerCase();
        if (/(hey burt|hi burt|burt)/i.test(transcript)) {
          stopWakeWordListener();
          if (asleep) wake();
          speak("What's up?", "happy");
          setTimeout(() => {
            listen();
          }, 1000);
          break;
        }
      }
    };

    wakeRec.onerror = () => {
      wakeWordActive = false;
      if (WAKEWORD_ENABLED && !busy && !speaking) setTimeout(startWakeWordListener, 2000);
    };

    wakeRec.onend = () => {
      wakeWordActive = false;
      if (WAKEWORD_ENABLED && !busy && !speaking && !configModal.classList.contains("open")) {
        setTimeout(startWakeWordListener, 1000);
      }
    };

    wakeRec.start();
  } catch (e) {
    wakeWordActive = false;
  }
}

function stopWakeWordListener() {
  if (wakeRec && wakeWordActive) {
    try { wakeRec.stop(); } catch (e) {}
    wakeWordActive = false;
  }
}

function listen() {
  stopWakeWordListener();
  if (busy || configModal.classList.contains("open")) return;
  if (speaking && "speechSynthesis" in window) {
    speechSynthesis.cancel();
    speaking = false;
    stage.classList.remove("talk");
  }
  if (!SR) {
    const t = prompt("Type your query for Burt:");
    if (t) ask(t);
    return;
  }
  const rec = new SR();
  rec.lang = navigator.language || "en-US";
  rec.interimResults = false;
  setFace("listening");
  say("Listening...", 6000);
  let heard = false;
  rec.onresult = ev => {
    heard = true;
    const t = ev.results[0][0].transcript;
    say(" " + t + " ", 3000);
    
    const cleanT = t.replace(/(hey burt|hi burt|burt)/gi, "").trim();
    ask(cleanT.length > 0 ? cleanT : t);
  };
  rec.onerror = ev => {
    heard = true;
    setFace("sad");
    say("Mic error: " + ev.error + ". Tap ⚙️ to fix permission.", 5000);
    setTimeout(() => {
      setFace("idle");
      if (WAKEWORD_ENABLED) startWakeWordListener();
    }, 2500);
  };
  rec.onend = () => {
    if (!heard) {
      setFace("idle");
      say("Didn't hear anything. Tap to try again.", 3000);
      if (WAKEWORD_ENABLED) startWakeWordListener();
    }
  };
  try { rec.start(); } catch (e) { setFace("idle"); }
}

async function requestMicPermission() {
  micStatus.textContent = "Requesting permission...";
  micStatus.style.color = "#88a";
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    micStatus.textContent = "❌ mediaDevices API not supported";
    micStatus.style.color = "#f04e4e";
    return;
  }
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    micStatus.textContent = "✅ Microphone access granted!";
    micStatus.style.color = "#4ef08d";
    stream.getTracks().forEach(track => track.stop());
    if (WAKEWORD_ENABLED) startWakeWordListener();
  } catch (err) {
    micStatus.textContent = "❌ Permission denied: " + (err.name || err.message);
    micStatus.style.color = "#f04e4e";
  }
}

async function requestCamPermission() {
  camStatus.textContent = "Testing camera access...";
  camStatus.style.color = "#88a";
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    camStatus.textContent = "❌ Camera API not supported";
    camStatus.style.color = "#f04e4e";
    return;
  }
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ video: true });
    camStatus.textContent = "✅ Camera access granted!";
    camStatus.style.color = "#4ef08d";
    stream.getTracks().forEach(track => track.stop());
  } catch (err) {
    camStatus.textContent = "❌ Camera blocked: " + (err.name || err.message);
    camStatus.style.color = "#f04e4e";
  }
}

let pressTimer, longFired = false;
document.addEventListener("pointerdown", e => {
  if (e.target.closest("#config-modal") || e.target.closest("#gear-btn") || e.target.closest("#test") || e.target.closest("#torch-overlay") || e.target.closest("#image-overlay") || e.target.closest("#radio-banner")) return;
  longFired = false;
  pressTimer = setTimeout(() => {
    longFired = true;
    if (!asleep) sleepNow();
  }, LONG_PRESS_MS);
});

document.addEventListener("pointerup", e => {
  if (e.target.closest("#config-modal") || e.target.closest("#gear-btn") || e.target.closest("#test") || e.target.closest("#torch-overlay") || e.target.closest("#image-overlay") || e.target.closest("#radio-banner")) return;
  clearTimeout(pressTimer);
  if (longFired) return;
  if (asleep) wake(); else listen();
});

function updateProviderFields() {
  const p = providerSelect.value;
  geminiKeyGroup.style.display = p === "gemini" ? "" : "none";
  grokKeyGroup.style.display = p === "grok" ? "" : "none";
}

function updateThemeFields() {
  customColorGroup.style.display = themeSelect.value === "custom" ? "" : "none";
}

function openConfigModal() {
  stopWakeWordListener();
  apiKeyInput.value = GEMINI_API_KEY;
  grokKeyInput.value = GROK_API_KEY;
  providerSelect.value = AI_PROVIDER;
  themeSelect.value = THEME_PRESET;
  customColorPicker.value = CUSTOM_COLOR;
  shapeSelect.value = AVATAR_SHAPE;
  wakewordToggle.checked = WAKEWORD_ENABLED;
  fillVoices();
  updateProviderFields();
  updateThemeFields();
  configModal.classList.add("open");
}

function closeConfigModal() {
  configModal.classList.remove("open");
  if (WAKEWORD_ENABLED) startWakeWordListener();
}

gearBtn.onclick = (e) => {
  e.stopPropagation();
  openConfigModal();
};

providerSelect.onchange = () => updateProviderFields();
themeSelect.onchange = () => updateThemeFields();
btnRequestMic.onclick = () => requestMicPermission();
btnRequestCam.onclick = () => requestCamPermission();

btnTestVoice.onclick = () => {
  const selectedVoice = voiceSelect.value;
  const prevVoice = VOICE_NAME;
  VOICE_NAME = selectedVoice;
  speak("Hey there! This is how I sound.", "happy");
  VOICE_NAME = prevVoice;
};

cancelConfigBtn.onclick = () => closeConfigModal();
saveConfigBtn.onclick = () => {
  const newKey = apiKeyInput.value.trim();
  GEMINI_API_KEY = newKey;
  localStorage.setItem("desk_buddy_gemini_key", newKey);
  
  AI_PROVIDER = providerSelect.value;
  GROK_API_KEY = grokKeyInput.value.trim();
  
  localStorage.setItem("desk_buddy_provider", AI_PROVIDER);
  localStorage.setItem("desk_buddy_grok_key", GROK_API_KEY);
  
  THEME_PRESET = themeSelect.value;
  CUSTOM_COLOR = customColorPicker.value;
  AVATAR_SHAPE = shapeSelect.value;

  localStorage.setItem("desk_buddy_theme", THEME_PRESET);
  localStorage.setItem("desk_buddy_custom_color", CUSTOM_COLOR);
  localStorage.setItem("desk_buddy_shape", AVATAR_SHAPE);

  applyVisualTheme(THEME_PRESET, CUSTOM_COLOR, AVATAR_SHAPE);

  VOICE_NAME = voiceSelect.value;
  localStorage.setItem("desk_buddy_voice", VOICE_NAME);

  WAKEWORD_ENABLED = wakewordToggle.checked;
  localStorage.setItem("desk_buddy_wakeword", WAKEWORD_ENABLED ? "true" : "false");
  
  closeConfigModal();
  say("Settings Saved!", 3000);
  setFace("happy");
  setTimeout(() => {
    setFace("idle");
    if (WAKEWORD_ENABLED) startWakeWordListener();
  }, 2000);
};

if (location.hash === "#test") {
  const t = document.getElementById("test");
  t.classList.add("on");
  for (const name of Object.keys(FACES)) {
    const b = document.createElement("button");
    b.textContent = name;
    b.onclick = () => {
      if (asleep) { asleep = false; stage.classList.remove("sleep"); }
      setFace(name);
      if (name === "sleep") sleepNow();
    };
    t.appendChild(b);
  }
}

setFace("idle");
if (WAKEWORD_ENABLED) {
  setTimeout(startWakeWordListener, 1000);
}
</script>
</body>
